[Unit]
Description=gfff buildbot scheduler (pueue)
Wants=pueued.service
Wants=network-online.target
After=pueued.service network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/share/gfff-buildbot/.venv/bin/gfff-buildbot --group-prefix gfff --tick 5
Restart=on-failure
RestartSec=10
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
